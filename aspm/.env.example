ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql+psycopg2://aspm:aspm@db:5432/aspm
LOG_LEVEL=INFO

# DAST (OWASP ZAP) — opcional
# Hosts privados autorizados para scan DAST (vazio = so IPs publicos)
DAST_ALLOWLIST_HOSTS=
# Imagem do ZAP; limites de CPU/mem do container
DAST_ZAP_IMAGE=zaproxy/zap-stable
DAST_CPU_LIMIT=2
DAST_MEM_LIMIT=2g
# Chave da API ZAP (so usada no modo daemon de debug)
ZAP_API_KEY=change-me
